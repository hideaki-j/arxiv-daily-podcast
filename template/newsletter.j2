<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>arXiv update {{ run_name }}</title>
</head>
<body style="margin:0; padding:0; background:#f3f4f6; color:#111827; font-family:Arial, Helvetica, sans-serif;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:#f3f4f6; margin:0; padding:24px 0;">
    <tr>
      <td align="center" style="padding:0 12px;">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="max-width:760px; background:#ffffff; border:1px solid #e5e7eb; border-radius:8px; overflow:hidden;">
          <tr>
            <td style="background:#0f766e; color:#ffffff; padding:24px 26px;">
              <div style="font-family:Georgia, 'Times New Roman', serif; font-size:28px; line-height:34px; font-weight:bold;">arXiv Update</div>
              <div style="font-size:14px; line-height:22px; color:#d1fae5; margin-top:4px;">One selected paper with scoring details</div>
              <div style="display:inline-block; margin-top:12px; padding:5px 9px; border:1px solid #99f6e4; border-radius:14px; color:#ecfdf5; font-size:12px; line-height:14px;">{{ run_name }}</div>
            </td>
          </tr>

          {% if notices %}
          <tr>
            <td style="padding:18px 26px 0;">
              {% for notice in notices %}
              <div style="margin:0 0 8px; padding:10px 12px; background:#eff6ff; border-left:4px solid #2563eb; border-radius:6px; font-size:13px; line-height:19px; color:#1f2937;">
                {{ notice }}
              </div>
              {% endfor %}
            </td>
          </tr>
          {% endif %}

          <tr>
            <td style="padding:18px 26px 4px;">
              <div style="font-size:13px; line-height:18px; color:#6b7280; font-weight:bold; text-transform:uppercase; letter-spacing:.04em; margin-bottom:8px;">Run Stats</div>
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
                <tr>
                  {% for stat in stats %}
                  <td width="25%" valign="top" style="padding:0 6px 8px 0;">
                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e5e7eb; border-radius:8px; background:#f9fafb;">
                      <tr>
                        <td style="padding:10px 10px 8px;">
                          <div style="font-size:22px; line-height:26px; font-weight:bold; color:#111827;">{{ stat.value }}</div>
                          <div style="font-size:12px; line-height:16px; color:#6b7280; margin-top:2px;">{{ stat.label }}</div>
                        </td>
                      </tr>
                    </table>
                  </td>
                  {% endfor %}
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding:10px 26px 28px;">
              {% for item in items %}
              <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="border:1px solid #e5e7eb; border-radius:8px; background:#ffffff;">
                <tr>
                  <td style="padding:20px 20px 14px;">
                    <div style="font-size:12px; line-height:16px; color:#0f766e; font-weight:bold; text-transform:uppercase; letter-spacing:.04em;">Selected Paper · {{ item.paper_id }}</div>
                    <h1 style="font-family:Georgia, 'Times New Roman', serif; font-size:24px; line-height:31px; margin:7px 0 8px; color:#111827;">
                      <a href="{{ item.arxiv_url }}" style="color:#0f766e; text-decoration:none;">{{ item.title }}</a>
                    </h1>
                    <div style="font-size:13px; line-height:20px; color:#4b5563;">
                      <div><strong>Authors:</strong> {{ item.authors }}</div>
                      <div><strong>Affiliations:</strong> {{ item.affiliations }}</div>
                      {% if item.published_line %}
                      <div><strong>Published:</strong> {{ item.published_line }}</div>
                      {% endif %}
                    </div>

                    {% if item.tldr %}
                    <div style="margin-top:14px; padding:12px 14px; background:#fffbeb; border-left:4px solid #d97706; border-radius:6px; font-size:14px; line-height:21px; color:#1f2937;">
                      <strong>TL;DR:</strong> {{ item.tldr }}
                    </div>
                    {% endif %}

                    <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-top:16px; border:1px solid #e5e7eb; border-radius:8px;">
                      <tr>
                        <td colspan="4" style="padding:12px 14px; background:#f9fafb; border-bottom:1px solid #e5e7eb;">
                          <span style="font-size:15px; line-height:20px; font-weight:bold; color:#111827;">Scoring Panel</span>
                          <span style="font-size:13px; line-height:20px; color:#6b7280;"> · final score {{ item.total_score }}</span>
                        </td>
                      </tr>
                      <tr>
                        <td style="padding:8px 10px; border-bottom:1px solid #e5e7eb; font-size:12px; color:#6b7280; font-weight:bold;">Label</td>
                        <td align="center" style="padding:8px 10px; border-bottom:1px solid #e5e7eb; font-size:12px; color:#6b7280; font-weight:bold;">Score</td>
                        <td align="center" style="padding:8px 10px; border-bottom:1px solid #e5e7eb; font-size:12px; color:#6b7280; font-weight:bold;">Type</td>
                        <td align="right" style="padding:8px 10px; border-bottom:1px solid #e5e7eb; font-size:12px; color:#6b7280; font-weight:bold;">Contribution</td>
                      </tr>
                      {% for row in item.score_rows %}
                      <tr>
                        <td style="padding:9px 10px; border-bottom:1px solid #f3f4f6; font-size:13px; line-height:18px; color:#111827;">{{ row.label }}</td>
                        <td align="center" style="padding:9px 10px; border-bottom:1px solid #f3f4f6; font-size:13px; line-height:18px; color:#111827; white-space:nowrap;">{{ row.score }} ({{ row.range }})</td>
                        <td align="center" style="padding:9px 10px; border-bottom:1px solid #f3f4f6; font-size:13px; line-height:18px; white-space:nowrap;">
                          {% if row.polarity == "minus" %}
                          <span style="display:inline-block; padding:2px 7px; border-radius:12px; background:#fef2f2; color:#b91c1c;">minus</span>
                          {% else %}
                          <span style="display:inline-block; padding:2px 7px; border-radius:12px; background:#ecfdf5; color:#047857;">plus</span>
                          {% endif %}
                        </td>
                        <td align="right" style="padding:9px 10px; border-bottom:1px solid #f3f4f6; font-size:13px; line-height:18px; color:#111827; white-space:nowrap;">{{ row.contribution }}</td>
                      </tr>
                      {% endfor %}
                    </table>
                  </td>
                </tr>
              </table>
              {% endfor %}
            </td>
          </tr>

          <tr>
            <td style="padding:0 26px 22px; color:#6b7280; font-size:12px; line-height:18px; text-align:center;">
              Generated by the Automatic Evaluation pipeline.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
